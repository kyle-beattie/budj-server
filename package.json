{
  "name": "budj-server",
  "version": "0.1.0",
  "private": true,
  "description": "Budj API server — Fastify + TypeScript + Drizzle + better-auth",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyle-beattie/budj-server.git"
  },
  "bugs": {
    "url": "https://github.com/kyle-beattie/budj-server/issues"
  },
  "homepage": "https://github.com/kyle-beattie/budj-server#readme",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:prod": "node dist/db/migrate.js",
    "db:studio": "drizzle-kit studio",
    "auth:generate": "better-auth generate --config src/modules/auth/auth.cli.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/sensible": "^6.0.4",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "better-auth": "^1.6.26",
    "close-with-grace": "^2.5.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.11.2",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.4",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "@prisma/client": false,
    "better-sqlite3": false
  }
}

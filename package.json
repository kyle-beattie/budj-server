{
  "name": "budj-server",
  "version": "0.1.0",
  "private": true,
  "description": "Budj API server — Fastify + TypeScript + Supabase (Postgres, PostgREST, Auth)",
  "type": "module",
  "main": "dist/server.js",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyle-beattie/budj-server.git"
  },
  "bugs": {
    "url": "https://github.com/kyle-beattie/budj-server/issues"
  },
  "homepage": "https://github.com/kyle-beattie/budj-server#readme",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff -f",
    "db:push": "supabase db push",
    "types:generate": "supabase gen types typescript --linked --schema public > src/supabase/database.types.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/sensible": "^6.0.4",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@supabase/supabase-js": "^2.112.0",
    "close-with-grace": "^2.5.0",
    "fastify": "^5.11.2",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "pino-pretty": "^13.1.3",
    "supabase": "^2.111.0",
    "tsx": "^4.23.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}

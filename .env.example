# ---- Runtime ----------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=debug

# Public URL this API is served from. On Render: https://budj-server.onrender.com
PUBLIC_URL=http://localhost:3000

# ---- Supabase ---------------------------------------------------------------
# Project settings -> Data API. For `supabase start`, use http://127.0.0.1:54321
# and the keys the CLI prints.
SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable ("anon") key. Subject to RLS; safe to ship to clients.
SUPABASE_ANON_KEY=your-anon-key
# Secret ("service_role") key. BYPASSES RLS — server only, never send to a client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Where Supabase sends users after email confirmation / password reset.
# Defaults to PUBLIC_URL. Must be listed under Auth -> URL Configuration.
AUTH_REDIRECT_URL=http://localhost:5173/auth/callback

# ---- Token custody -----------------------------------------------------------
# Encrypts provider credentials at rest: the Akahu access token and Apple's
# refresh token. Format is <version>:<base64 of 32 bytes>, newest first.
#
# Generate one with:
#   node -e "console.log('v1:' + require('crypto').randomBytes(32).toString('base64'))"
#
# To rotate, put the new key first and keep the old one so existing rows still
# decrypt: TOKEN_ENC_KEY=v2:<new>,v1:<old>
#
# LOSING THIS orphans every stored token and forces every user to reconnect
# their bank. In production it lives in Render's secret store, never here.
TOKEN_ENC_KEY=v1:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# ---- Sign in with Apple ------------------------------------------------------
# Used only to exchange the authorization code captured at sign-in for a refresh
# token, so the account can be revoked with Apple at deletion. NOT the App Store
# Connect key — that is a separate credential, added with the billing module.
#
# The .p8 key EXPIRES EVERY SIX MONTHS and the exchange fails quietly when it
# lapses. See the runbook.
APPLE_TEAM_ID=ABCDE12345
APPLE_KEY_ID=FGHIJ67890
# Contents of the .p8, PEM encoded. Newlines may be written as literal \n.
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----"
# The app's bundle identifier.
APPLE_CLIENT_ID=com.example.budj

# ---- Clients ----------------------------------------------------------------
# Comma-separated list of browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- App Store Connect / StoreKit --------------------------------------------
# A DIFFERENT credential from the Sign in with Apple key above. Used to call the
# App Store Server API. Verifying notifications and transactions needs none of
# it — that is a certificate chain to Apple's pinned root.
APP_STORE_ISSUER_ID=00000000-0000-0000-0000-000000000000
APP_STORE_KEY_ID=KLMNO12345
APP_STORE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----"
APP_STORE_BUNDLE_ID=com.example.budj
APP_STORE_APP_APPLE_ID=1234567890
# Sandbox or Production. Accepting both would let a sandbox purchase entitle a
# production account.
APP_STORE_ENVIRONMENT=Sandbox

# ---- Akahu -------------------------------------------------------------------
# App ID Token and App Secret from the Akahu dashboard.
AKAHU_APP_TOKEN=app_token_replace_me
AKAHU_APP_SECRET=replace-me
# Must be REGISTERED with Akahu and match byte-for-byte, trailing slash included.
# A mismatch fails the code exchange, not the redirect, so it looks like a token
# problem rather than a configuration one.
AKAHU_REDIRECT_URI=http://localhost:3000/api/bank-connections/callback

# ---- Runtime ----------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=debug

# ---- Database ---------------------------------------------------------------
# Render gives you an Internal Database URL (no SSL needed, set DATABASE_SSL=false)
# and an External Database URL (SSL required, set DATABASE_SSL=true).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/budj
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# ---- Auth (better-auth) -----------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-32-byte-random-string
# Public URL this API is served from. On Render: https://budj-server.onrender.com
BETTER_AUTH_URL=http://localhost:3000

# ---- Clients ----------------------------------------------------------------
# Comma-separated list of browser origins allowed to call this API with cookies.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

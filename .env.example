# ---- Runtime ----------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=debug

# Public URL this API is served from. On Render: https://budj-server.onrender.com
PUBLIC_URL=http://localhost:3000

# ---- Supabase ---------------------------------------------------------------
# Project settings -> Data API. For `supabase start`, use http://127.0.0.1:54321
# and the keys the CLI prints.
SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable ("anon") key. Subject to RLS; safe to ship to clients.
SUPABASE_ANON_KEY=your-anon-key
# Secret ("service_role") key. BYPASSES RLS — server only, never send to a client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Where Supabase sends users after email confirmation / password reset.
# Defaults to PUBLIC_URL. Must be listed under Auth -> URL Configuration.
AUTH_REDIRECT_URL=http://localhost:5173/auth/callback

# ---- Clients ----------------------------------------------------------------
# Comma-separated list of browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
